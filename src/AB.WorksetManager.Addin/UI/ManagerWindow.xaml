<Window x:Class="AB.WorksetManager.Addin.UI.ManagerWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AB Worksets Manager" Width="1080" Height="740" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#F4F6F9" FontFamily="Segoe UI" FontSize="12" Foreground="#1F2933">

    <Window.Resources>
        <!-- AB Adv Tools brand: navy banner, blue accent. -->
        <SolidColorBrush x:Key="Navy" Color="#172230" />
        <SolidColorBrush x:Key="NavySubtle" Color="#96AFCD" />
        <SolidColorBrush x:Key="Accent" Color="#1F6FEB" />
        <SolidColorBrush x:Key="AccentDark" Color="#1858BC" />
        <SolidColorBrush x:Key="Danger" Color="#C62828" />
        <SolidColorBrush x:Key="Border" Color="#D0D7DE" />
        <SolidColorBrush x:Key="Muted" Color="#5F6B78" />
        <SolidColorBrush x:Key="Panel" Color="#F6F8FA" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Danger}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Bar" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ActionBar" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EAEE" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="#E6EAEE" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFF" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- One click ticks the box (no "select the row first"). -->
        <DataTemplate x:Key="TickCell">
            <CheckBox Tag="Tick" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTick}"
                      HorizontalAlignment="Center" Margin="0" Focusable="False" />
        </DataTemplate>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="5" />
            <RowDefinition Height="150" MinHeight="60" />
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" Background="{StaticResource Navy}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ModelText" Foreground="White" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    <TextBlock x:Name="UserText" Foreground="{StaticResource NavySubtle}" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AB Worksets Manager" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Every change is checked first, skips what others have borrowed, and is one Undo (Ctrl+Z)."
                               Foreground="{StaticResource NavySubtle}" />
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource NavySubtle}">
                        <Run x:Name="CopyrightRun" />
                        <Run Text="  |  " />
                        <Hyperlink x:Name="LinkedInLink" Click="LinkedIn_Click" Foreground="#7FB2FF" TextDecorations="{x:Null}"
                                   ToolTip="Open Abdullah Lotfy's LinkedIn profile">
                            <Run x:Name="LinkedInRun" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="10,10,10,0" SelectionChanged="Tabs_SelectionChanged">

            <!-- ============================================================ 0 Overview -->
            <TabItem Header="Overview">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                        <Button Content="Refresh" Click="OvRefresh_Click" />
                        <Button Content="Export to Excel..." Click="OvExport_Click" />
                        <Button Content="Make active" Click="OvMakeActive_Click" ToolTip="Make the selected workset the active workset (new elements go on it)." />
                        <TextBlock x:Name="OvSummary" Style="{StaticResource Label}" Margin="10,0,0,0" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <DataGrid x:Name="OvGrid" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="55" />
                            <DataGridTextColumn Header="Workset" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Elements" Binding="{Binding Elements}" Width="80" />
                            <DataGridTextColumn Header="Open" Binding="{Binding Open}" Width="60" />
                            <DataGridTextColumn Header="Editable by you" Binding="{Binding Editable}" Width="110" />
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="150" />
                            <DataGridTextColumn Header="Visible in all views" Binding="{Binding Visible}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ 1 Create -->
            <TabItem Header="Create">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Section}" Text="Workset names" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                   Text="One per line, or paste from Excel. A second column of Yes/No sets 'Visible in all views'. Lines starting with # are ignored." />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Load Excel / CSV / text..." Click="CrLoad_Click" />
                            <Button Content="Check" Click="CrCheck_Click" Style="{StaticResource Primary}" />
                        </StackPanel>
                        <TextBox x:Name="CrText" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" x:Name="CrSummary" Style="{StaticResource Hint}" Text="Press Check to compare the list with the model." />
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Tick all ready" Click="CrTickAll_Click" />
                                <Button Content="Untick all" Click="CrUntick_Click" />
                                <Button x:Name="CrCreate" Content="Create ticked worksets" Click="CrCreate_Click" Style="{StaticResource Primary}" Margin="12,0,0,0" />
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="CrGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Create" CellTemplate="{StaticResource TickCell}" Width="55" />
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="45" IsReadOnly="True" />
                                <DataGridTextColumn Header="Workset" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Visible in all views" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Visible, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ 2 Rename -->
            <TabItem Header="Rename">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Type the new names, or load a list with two columns: current name and new name (Export list gives you a ready Excel file - edit the New Name column and load it back). Rows without a new name are left as they are." />
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                        <Button Content="Load list..." Click="RnLoad_Click" />
                        <Button Content="Export list..." Click="RnExport_Click" />
                        <Button Content="Clear new names" Click="RnClear_Click" />
                        <Button Content="Check" Click="RnCheck_Click" />
                        <TextBlock x:Name="RnSummary" Style="{StaticResource Label}" Margin="10,0,0,0" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Rename" Click="RnRename_Click" Style="{StaticResource Primary}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="6,4,0,0" Text="All renames happen together, or none do." />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="RnGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Current name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="New name" Binding="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ 3 Grids / Levels -->
            <TabItem Header="Grids / Levels">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                        <CheckBox x:Name="GlScope" Content="Include scope boxes" Click="GlOptions_Click" />
                        <CheckBox x:Name="GlRefPlanes" Content="Include reference planes" Click="GlOptions_Click" />
                        <TextBlock Text="Search" Style="{StaticResource Label}" />
                        <TextBox x:Name="GlSearch" Width="180" TextChanged="GlSearch_TextChanged" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                        <Button Content="Tick all grids and levels" Click="GlTickAll_Click" />
                        <Button Content="Tick all shown" Click="GlTickShown_Click" />
                        <Button Content="Untick all" Click="GlUntick_Click" />
                        <Button Content="Tick Revit selection" Click="GlSelection_Click" />
                        <Button Content="Pick in model..." Click="GlPick_Click" />
                        <TextBlock x:Name="GlCount" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Target workset" Style="{StaticResource Label}" />
                            <ComboBox x:Name="GlTarget" Width="260" DisplayMemberPath="Name" Margin="0,0,6,0" />
                            <Button Content="Shared Levels and Grids" Click="GlDefault_Click" ToolTip="Choose the 'Shared Levels and Grids' workset as the target." />
                            <Button Content="Move ticked" Click="GlMove_Click" Style="{StaticResource Primary}" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="GlGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Move" CellTemplate="{StaticResource TickCell}" Width="50" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Current workset" Binding="{Binding Workset}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Status}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ 4 Revit / CAD -->
            <TabItem Header="Revit / CAD">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Revit link workset name" Style="{StaticResource Label}" />
                        <TextBox x:Name="LkRvtTemplate" Grid.Column="1" />
                        <TextBlock Grid.Column="2" Text="CAD workset name" Style="{StaticResource Label}" Margin="12,0,6,0" />
                        <TextBox x:Name="LkCadTemplate" Grid.Column="3" />
                        <Button Grid.Column="4" Content="Apply names" Click="LkApplyNames_Click" Margin="8,0,0,0"
                                ToolTip="Fill the 'New workset' column of the ticked rows (all rows if none is ticked) from these patterns." />
                        <TextBlock Grid.Column="5" Style="{StaticResource Hint}" Margin="8,4,0,0" Text="{}{FileName} {Kind} = RVT/CAD" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                        <Button Content="Tick all" Click="LkTickAll_Click" />
                        <Button Content="Untick all" Click="LkUntick_Click" />
                        <Button Content="Tick Revit selection" Click="LkSelection_Click" />
                        <Button Content="Pick in model..." Click="LkPick_Click" />
                        <Button Content="Refresh" Click="LkRefresh_Click" />
                        <TextBlock x:Name="LkCount" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Target workset" Style="{StaticResource Label}" />
                            <ComboBox x:Name="LkTarget" Width="240" DisplayMemberPath="Name" Margin="0,0,6,0" />
                            <Button Content="Move ticked to target" Click="LkMove_Click" Style="{StaticResource Primary}" />
                            <TextBlock Text="or" Style="{StaticResource Label}" Margin="10,0,10,0" />
                            <Button Content="Create a workset per link and move" Click="LkCreatePer_Click" Style="{StaticResource Primary}"
                                    ToolTip="Each ticked link goes to the workset in its 'New workset' column, created when it does not exist." />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="LkGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Use" CellTemplate="{StaticResource TickCell}" Width="45" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="85" IsReadOnly="True" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Instance workset" Binding="{Binding InstanceWorkset}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Type workset" Binding="{Binding TypeWorkset}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="New workset (editable)" Binding="{Binding NewWorkset, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Status}" Width="160" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ 5 3D Views -->
            <TabItem Header="3D Views">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Each view shows the ticked worksets and hides every other workset. A 3D view that already has the name is updated, not duplicated." />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name of each view" Style="{StaticResource Label}" />
                        <TextBox x:Name="V3SingleName" Grid.Column="1" />
                        <TextBlock Grid.Column="2" Text="Combined view name" Style="{StaticResource Label}" Margin="12,0,6,0" />
                        <TextBox x:Name="V3CombinedName" Grid.Column="3" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Hint}" Margin="8,4,0,0" Text="{}{Workset} = workset name" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                        <Button Content="Tick all" Click="V3TickAll_Click" />
                        <Button Content="Untick all" Click="V3Untick_Click" />
                        <TextBlock x:Name="V3Count" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create one combined view" Click="V3Combined_Click" Style="{StaticResource Primary}" />
                            <Button Content="Create one view per workset" Click="V3Single_Click" Style="{StaticResource Primary}" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="V3Grid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Show" CellTemplate="{StaticResource TickCell}" Width="50" />
                            <DataGridTextColumn Header="Workset" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Elements" Binding="{Binding Elements}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Open" Binding="{Binding Open}" Width="70" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ 6 Families -->
            <TabItem Header="Families">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                        <TextBlock Text="Category" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ElCategory" Width="190" SelectionChanged="ElFilter_Changed" Margin="0,0,10,0" />
                        <TextBlock Text="On workset" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ElSource" Width="190" SelectionChanged="ElFilter_Changed" Margin="0,0,10,0" />
                        <TextBlock Text="Search" Style="{StaticResource Label}" />
                        <TextBox x:Name="ElSearch" Width="160" TextChanged="ElSearch_TextChanged" ToolTip="Searches category, family, type and workset" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                        <Button Content="Tick all shown" Click="ElTickShown_Click" />
                        <Button Content="Untick all" Click="ElUntick_Click" />
                        <Button Content="Refresh" Click="ElRefresh_Click" />
                        <TextBlock x:Name="ElCount" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Target workset" Style="{StaticResource Label}" />
                            <ComboBox x:Name="ElTarget" Width="240" DisplayMemberPath="Name" Margin="0,0,6,0" />
                            <Button Content="Move ticked" Click="ElMove_Click" Style="{StaticResource Primary}" />
                            <TextBlock Text="or" Style="{StaticResource Label}" Margin="10,0,10,0" />
                            <Button Content="Pick elements and move..." Click="ElPick_Click"
                                    ToolTip="Pick elements in the model; exactly those move to the target workset." />
                            <TextBlock Style="{StaticResource Hint}" Margin="6,4,0,0" Text="Grouped elements move with their whole model group." />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="ElGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Move" CellTemplate="{StaticResource TickCell}" Width="50" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Workset" Binding="{Binding Workset}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ 7 Visibility -->
            <TabItem Header="Visibility">
                <DockPanel Margin="10">
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Set ticked worksets to" Style="{StaticResource Label}" />
                                <RadioButton x:Name="ViShow" Content="Show" IsChecked="True" GroupName="ViState" />
                                <RadioButton x:Name="ViHide" Content="Hide" GroupName="ViState" />
                                <RadioButton x:Name="ViGlobal" Content="Use global setting" GroupName="ViState" />
                                <TextBlock Text="When a view template controls worksets:" Style="{StaticResource Label}" Margin="12,0,6,0" />
                                <RadioButton x:Name="ViSkipTemplate" Content="skip the view" IsChecked="True" GroupName="ViTemplate" />
                                <RadioButton x:Name="ViChangeTemplate" Content="change the template" GroupName="ViTemplate" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Apply to ticked views" Click="ViApply_Click" Style="{StaticResource Primary}" />
                                <Button Content="Check status..." Click="ViStatus_Click" />
                                <TextBlock Text="Visible in all views (global):" Style="{StaticResource Label}" Margin="16,0,6,0" />
                                <Button Content="On" Click="ViGlobalOn_Click" MinWidth="45" />
                                <Button Content="Off" Click="ViGlobalOff_Click" MinWidth="45" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                                <ComboBox x:Name="ViKind" Width="150" SelectionChanged="ViFilter_Changed" Margin="0,0,6,0" />
                                <TextBox x:Name="ViSearch" Width="150" TextChanged="ViSearch_TextChanged" ToolTip="Search view names" />
                                <Button Content="Tick shown" Click="ViTickViews_Click" Margin="6,0,6,0" />
                                <Button Content="Untick" Click="ViUntickViews_Click" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" x:Name="ViViewCount" Style="{StaticResource Hint}" />
                            <DataGrid x:Name="ViViews">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Use" CellTemplate="{StaticResource TickCell}" Width="40" />
                                    <DataGridTextColumn Header="View / template" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding ViewType}" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Worksets set by template" Binding="{Binding Template}" Width="*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                                <Button Content="Tick all" Click="ViTickWs_Click" />
                                <Button Content="Untick" Click="ViUntickWs_Click" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" x:Name="ViWsCount" Style="{StaticResource Hint}" />
                            <DataGrid x:Name="ViWorksets">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Use" CellTemplate="{StaticResource TickCell}" Width="40" />
                                    <DataGridTextColumn Header="Workset" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Global" Binding="{Binding Visible}" Width="60" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ 8 Delete -->
            <TabItem Header="Delete">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Tick the worksets to delete. Their elements move to the target workset first - nothing is deleted except the empty worksets. Synchronize with Central afterwards." />
                    <StackPanel DockPanel.Dock="Top" Style="{StaticResource Bar}">
                        <Button Content="Untick all" Click="DlUntick_Click" />
                        <Button Content="Check" Click="DlCheck_Click" />
                        <TextBlock x:Name="DlCount" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Move their elements to" Style="{StaticResource Label}" />
                            <ComboBox x:Name="DlTarget" Width="260" DisplayMemberPath="Name" Margin="0,0,12,0" SelectionChanged="DlTarget_Changed" />
                            <Button Content="Delete ticked worksets..." Click="DlDelete_Click" Style="{StaticResource DangerButton}" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="DlGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Delete" CellTemplate="{StaticResource TickCell}" Width="55" />
                            <DataGridTextColumn Header="Workset" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Elements" Binding="{Binding Elements}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Check" Binding="{Binding Status}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Results -->
        <DockPanel Grid.Row="3" Margin="10,0,10,10">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy" Click="ResultsCopy_Click" MinWidth="55" />
                    <Button Content="Clear" Click="ResultsClear_Click" MinWidth="55" />
                    <Button Content="Close" Click="Close_Click" MinWidth="70" Margin="0" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                           ToolTip="Select rows with Shift+click or Ctrl+click, then tick one of their boxes (or press Space) to tick them all. Shift+click a box ticks the range from the last box you clicked.">
                    <Run Text="Results" FontWeight="SemiBold" />
                    <Run Text="     Tip: Shift+click or Ctrl+click rows, then tick one box or press Space to tick them all." Foreground="{StaticResource Muted}" />
                </TextBlock>
            </DockPanel>
            <TextBox x:Name="ResultsBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="White" TextWrapping="NoWrap" />
        </DockPanel>
    </Grid>
</Window>
